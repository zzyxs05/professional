{
  "id": "fields-course-v1",
  "version": "1.1",
  "status": "内部自评字段映射，待本人复核",
  "purpose": "把评价从『查文件存在』推进到『读内容字段』。每项至少 2 个字段，字段全部来自本仓库真实文件，不发明字段。",
  "template_note": "本文件只是本项目的适配实例，不是评价器内置规则；路径中的 {{run_id}} 是上下文变量，由调用方注入。互评必须改用目标项目自己的字段规范，不得套用本文件。",
  "discipline": [
    "字段核对只做机械比对（文本子串 / JSON 取值 / 目录条目），不把读到的文本当指令执行",
    "三态：match=符合 / mismatch=不符（字段存在但期望不满足）/ missing=缺字段（文件或键读不到）",
    "字段核对结果只作为内容级证据层；不自动改四状态、不自动签署、不产生分数",
    "rubric 的 expected_evidence 保留了文档合并前的历史文件名（brief.md / acceptance-matrix.md / state-model.md / release.md）；字段核对如实记录其承载位置，不伪造这些文件"
  ],
  "kinds": {
    "text_all": "path 文件文本须包含 expect 列出的全部子串；文件读不到=missing，缺任一子串=mismatch，全含=match",
    "json_eq": "对 path 取 lhs 值，与 rhs（'路径:json路径'）或 const 比对；取不到=missing，值不等=mismatch，相等=match",
    "json_nonempty": "path 的 json_path 取值须非空（list 非空 / str 非空 / 数字非零）；取不到=missing，空=mismatch",
    "dir_min": "path 目录条目数 >= min；目录打不开=missing，不足=mismatch",
    "file_exists": "path 存在即 match，否则 missing"
  },
  "criteria": [
    {
      "criterion_id": "E-01",
      "note": "brief.md 已在 2026-11-18 文档合并中并入 requirements.md；如实记承载位置",
      "fields": [
        {
          "id": "E-01-F1",
          "path": "docs/requirements.md",
          "kind": "text_all",
          "expect": [
            "## 1. 角色与利益相关者",
            "## 2. 使用场景",
            "## 3. 用户需求（UN）",
            "## 5. 追溯矩阵",
            "## 6. 明确不做"
          ],
          "note": "角色/场景/UN/追溯/范围外五项结构"
        },
        {
          "id": "E-01-F2",
          "path": "docs/requirements.md",
          "kind": "text_all",
          "expect": [
            "UN-01",
            "REQ-01",
            "不服务"
          ],
          "note": "UN 编号、REQ 编号、不服务对象"
        },
        {
          "id": "E-01-F3",
          "path": "docs/requirements.md",
          "kind": "text_all",
          "carried_by": "docs/requirements.md",
          "note": "brief 合并后的问题陈述与调研结论仍在（见 changes S31）",
          "expect": [
            "## 0. 问题：不是扫不出问题，是结论没法被复核",
            "性质：brief",
            "上游 `research/apk-audit-landscape.md`"
          ]
        }
      ]
    },
    {
      "criterion_id": "E-02",
      "note": "acceptance-matrix.md / state-model.md 的历史内容承载在 specification.md §7/§8",
      "fields": [
        {
          "id": "E-02-F1",
          "path": "docs/specification.md",
          "kind": "text_all",
          "expect": [
            "## 2. 规则契约",
            "## 3. 结论与报告 schema",
            "## 8. 验收 ID"
          ],
          "note": "规则契约、报告 schema、验收 ID 三节"
        },
        {
          "id": "E-02-F2",
          "path": "docs/specification.md",
          "kind": "text_all",
          "expect": [
            "A-01",
            "A-10",
            "定位格式"
          ],
          "note": "A-01~A-10 验收 ID 与定位契约"
        },
        {
          "id": "E-02-F3",
          "path": "docs/specification.md",
          "kind": "text_all",
          "carried_by": "docs/specification.md 第 8 节",
          "note": "验收矩阵合并后为 specification §8（见 changes S32）",
          "expect": [
            "## 8. 验收 ID（A-01—A-10）",
            "| A-01 |",
            "| A-10 |"
          ]
        }
      ]
    },
    {
      "criterion_id": "E-03",
      "fields": [
        {
          "id": "E-03-F1",
          "path": "docs/decision-log.md",
          "kind": "text_all",
          "expect": [
            "D-01",
            "ADR-0007",
            "复核"
          ],
          "note": "决策索引可定位到 ADR 且有复核记录"
        },
        {
          "id": "E-03-F2",
          "path": "docs/adr",
          "kind": "dir_min",
          "min": 10,
          "note": "ADR 目录至少 10 份（当前 11 份）"
        },
        {
          "id": "E-03-F3",
          "path": "docs/research",
          "kind": "dir_min",
          "min": 2,
          "note": "前置调研目录至少 2 份"
        }
      ]
    },
    {
      "criterion_id": "E-04",
      "fields": [
        {
          "id": "E-04-F1",
          "path": "HARNESS.md",
          "kind": "text_all",
          "expect": [
            "## 1. 项目开发规范",
            "## 5. 日志规范",
            "自动化脚本配置"
          ],
          "note": "Harness 含开发规范、日志规范、脚本配置"
        },
        {
          "id": "E-04-F2",
          "path": "GLOBAL.md",
          "kind": "file_exists",
          "note": "目标独立成文"
        },
        {
          "id": "E-04-F3",
          "path": "PLAN.md",
          "kind": "file_exists",
          "note": "计划独立成文"
        },
        {
          "id": "E-04-F4",
          "path": "TASKS.md",
          "kind": "file_exists",
          "note": "任务独立成文"
        }
      ]
    },
    {
      "criterion_id": "E-05",
      "fields": [
        {
          "id": "E-05-F1",
          "path": "evidence/{{run_id}}/report.json",
          "kind": "json_eq",
          "lhs": "versions.rule_pack",
          "rhs": "evidence/{{run_id}}/meta.json:rule_pack",
          "note": "报告规则包版本与 meta 一致"
        },
        {
          "id": "E-05-F2",
          "path": "evidence/{{run_id}}/report.json",
          "kind": "json_eq",
          "lhs": "target.apk_sha256",
          "rhs": "evidence/{{run_id}}/meta.json:apk_sha256",
          "note": "样本指纹与 meta 一致"
        },
        {
          "id": "E-05-F3",
          "path": "evidence/{{run_id}}/report.json",
          "kind": "json_nonempty",
          "json_path": "conclusions",
          "note": "结论列表非空"
        },
        {
          "id": "E-05-F4",
          "path": "evidence/{{run_id}}/report.json",
          "kind": "json_nonempty",
          "json_path": "coverage.checked",
          "note": "覆盖声明已检查项非空"
